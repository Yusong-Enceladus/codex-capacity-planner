diff --git a/Tests/CodexBarTests/PlannerCostCacheTests.swift b/Tests/CodexBarTests/PlannerCostCacheTests.swift
new file mode 100644
--- /dev/null
+++ b/Tests/CodexBarTests/PlannerCostCacheTests.swift
@@ -0,0 +1,15 @@
+import Commander
+import Foundation
+import Testing
+@testable import CodexBarCLI
+
+struct PlannerCostCacheTests {
+    @Test
+    func `cost cache override is explicit and does not change the default`() throws {
+        let parser = CommandParser(signature: CodexBarCLI._costSignatureForTesting())
+        let defaults = try parser.parse(arguments: [])
+        #expect(CodexBarCLI.costCacheRoot(from: defaults) == nil)
+        let custom = try parser.parse(arguments: ["--cache-root", "/tmp/planner-cost-test"])
+        #expect(CodexBarCLI.costCacheRoot(from: custom)?.path == "/tmp/planner-cost-test")
+    }
+}
