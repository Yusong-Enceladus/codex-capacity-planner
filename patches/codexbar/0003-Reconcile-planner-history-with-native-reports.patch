+            let now = try #require(ISO8601DateFormatter().date(from: "2026-08-30T12:00:00Z"))
+            let at = "2026-08-30T06:59:00Z"
+            _ = try env.writeCodexSessionFile(day: now, filename: "boundary.jsonl", contents: env.jsonl([
+                ["type": "session_meta", "payload": ["id": "boundary"]],
+                ["type": "turn_context", "payload": ["model": self.model]],
+                ["type": "event_msg", "timestamp": at, "payload": ["type": "token_count", "info": [
+                    "total_token_usage": ["input_tokens": 100, "cached_input_tokens": 40, "output_tokens": 10],
+                ]]],
+            ]))
+            var calendar = Calendar(identifier: .gregorian)
+            calendar.timeZone = try #require(TimeZone(identifier: zone))
+            var options = CostUsageScanner.Options(
+                codexSessionsRoot: env.codexSessionsRoot,
+                cacheRoot: env.cacheRoot,
+                calendar: calendar)
+            options.refreshMinIntervalSeconds = 0
+            let since = now.addingTimeInterval(-7 * 86400)
+            let native = CostUsageScanner.loadDailyReport(
+                provider: .codex,
+                since: since,
+                until: now,
+                now: now,
+                options: options)
+            let cache = CostUsageStoreAccess.read(cacheRoot: env.cacheRoot, calendar: calendar)
+            let range = CostUsageScanner.CostUsageDayRange(since: since, until: now, calendar: calendar)
+            let export = PlannerUsageExport.snapshot(cache: cache, range: range, catalog: nil, cacheRoot: env.cacheRoot)
+            #expect(export.sources.flatMap(\.rows).reduce(0) { $0 + $1.totalTokens } == native.summary?.totalTokens)
+            #expect(export.sources.flatMap(\.rows).first?
+                .date == (zone == "Asia/Shanghai" ? "2026-08-30" : "2026-08-29"))
+        }
+    }
