diff --git a/Sources/CodexBarCore/PlannerUsageExport.swift b/Sources/CodexBarCore/PlannerUsageExport.swift
new file mode 100644
index 0000000..0ddaa10
--- /dev/null
+++ b/Sources/CodexBarCore/PlannerUsageExport.swift
@@ -0,0 +1,315 @@
+import Foundation
+
+/// Local-only export for the planner. Counts, fork reconciliation and prices
+/// come from the same report builder as CodexBar, never from raw ledger sums.
+enum PlannerUsageExport {
+    struct Row: Encodable {
+        let date: String
+        let model: String
+        let mode: String
+        let inputTokens: Int
+        let cachedTokens: Int
+        let outputTokens: Int
+        let totalTokens: Int
+        let estimatedCostUSD: Double?
+        let eventCount: Int
+    }
+
+    struct Source: Encodable {
+        let id: String
+        let path: String?
+        let sessionID: String?
+        let project: String?
+        let title: String?
+        let complete: Bool
+        let rows: [Row]
+    }
+
+    struct Snapshot: Encodable {
+        let version = 2
+        let timeZone: String
+        let startDay: String
+        let endDay: String
+        let scannedAt: String?
+        let complete: Bool
+        let completedFiles: Int
+        let totalFiles: Int
+        let processedBytes: Int64
+        let totalBytes: Int64
+        let sources: [Source]
+    }
+
+    static func write(
+        options: CostUsageScanner.Options,
+        destination: URL,
+        historyDays: Int,
+        now: Date,
+        refresh: Bool) async throws
+    {
+        if refresh {
+            await ModelsDevPricingPipeline.refreshIfNeeded(
+                now: now,
+                cacheRoot: options.cacheRoot,
+                client: ModelsDevClient())
+        }
+        try await CostUsageScanExecutor.run { checkCancellation in
+            let since = options.calendar.date(byAdding: .day, value: -(historyDays - 1), to: now) ?? now
+            if refresh {
+                // Publish every bounded pass. Rebuilding a large native report
+                // repeatedly can exhaust the process deadline before any progress
+                // reaches the UI; the worker resumes while catch-up is pending.
+                _ = try CostUsageScanner.loadDailyReportCancellable(
+                    provider: .codex,
+                    since: since,
+                    until: now,
+                    now: now,
+                    options: options,
+                    checkCancellation: checkCancellation)
+                var piOptions = PiSessionCostScanner.Options()
+                piOptions.cacheRoot = options.cacheRoot
+                piOptions.calendar = options.calendar
+                _ = try PiSessionCostScanner.loadDailyReportCancellable(
+                    provider: .codex,
+                    since: since,
+                    until: now,
+                    now: now,
+                    options: piOptions,
+                    checkCancellation: checkCancellation)
+            }
+            try checkCancellation()
+            let cache = CostUsageScanner.codexCache(
+                CostUsageStoreAccess.read(cacheRoot: options.cacheRoot, calendar: options.calendar),
+                scopedTo: CostUsageScanner.codexSessionsRoots(options: options))
+            let range = CostUsageScanner.CostUsageDayRange(since: since, until: now, calendar: options.calendar)
+            let turns = CostUsageScanner.codexPriorityTurns(
+                databaseURL: options.codexTraceDatabaseURL,
+                sinceDayKey: range.scanSinceKey,
+                untilDayKey: range.scanUntilKey)
+            let catalog = CostUsagePricing.modelsDevCatalog(now: now, cacheRoot: options.cacheRoot)
+            let snapshot = Self.snapshot(
+                cache: cache,
+                range: range,
+                catalog: catalog,
+                cacheRoot: options.cacheRoot,
+                priorityTurns: turns,
+                pi: PiSessionCostCacheIO.load(cacheRoot: options.cacheRoot),
+                now: now)
+            let data = try JSONEncoder().encode(snapshot)
+            try FileManager.default.createDirectory(
+                at: destination.deletingLastPathComponent(),
+                withIntermediateDirectories: true,
+                attributes: [.posixPermissions: 0o700])
+            try data.write(to: destination, options: .atomic)
+            try FileManager.default.setAttributes([.posixPermissions: 0o600], ofItemAtPath: destination.path)
+        }
+    }
+
+    static func snapshot(
+        cache rawCache: CostUsageCache,
+        range: CostUsageScanner.CostUsageDayRange,
+        catalog: ModelsDevCatalog?,
+        cacheRoot: URL?,
+        priorityTurns: [String: CostUsageScanner.CodexPriorityTurnMetadata] = [:],
+        pi: PiSessionCostCache = PiSessionCostCache(),
+        now: Date = Date()) -> Snapshot
+    {
+        var cache = rawCache
+        for (path, usage) in cache.files where CostUsageScanner.needsCodexPricingMetadata(usage, range: range) {
+            cache.files[path] = CostUsageScanner.codexFileUsageWithPricingMetadata(
+                usage,
+                range: range,
+                priorityTurns: priorityTurns)
+        }
+        let rowPriced = Self.rowPricedGroups(
+            cache: cache,
+            range: range,
+            catalog: catalog,
+            cacheRoot: cacheRoot,
+            priorityTurns: priorityTurns)
+        let report = CostUsageScanner.buildCodexReportFromCache(
+            cache: cache,
+            range: range,
+            modelsDevCatalog: catalog,
+            modelsDevCacheRoot: cacheRoot,
+            priorityTurns: priorityTurns)
+        let unpriced = Set(report.data.flatMap { entry in
+            (entry.modelBreakdowns ?? []).filter { $0.costUSD == nil }.map {
+                CostUsageScanner.CodexDayModelKey(day: entry.date, model: $0.modelName)
+            }
+        })
+        var sources: [Source] = []
+        for (path, usage) in cache.files.sorted(by: { $0.key < $1.key }) {
+            let canonical = CostUsageScanner.codexCanonicalPricingRows(usage)
+            let grouped = Dictionary(grouping: canonical.rows) {
+                CostUsageScanner.CodexDayModelKey(day: $0.day, model: $0.model)
+            }
+            let modeEvidence = CostUsageScanner.codexPricingModeEvidence(
+                usage: usage,
+                reconciledRows: canonical.rows,
+                range: range,
+                priorityTurns: priorityTurns)
+            var rows: [Row] = []
+            for day in usage.days.keys.sorted() where day >= range.sinceKey && day <= range.untilKey {
+                for model in (usage.days[day] ?? [:]).keys.sorted() {
+                    let key = CostUsageScanner.CodexDayModelKey(day: day, model: model)
+                    let packed = usage.days[day]?[model] ?? [0, 0, 0]
+                    let events = grouped[key] ?? []
+                    let canSplit = !events.isEmpty && !canonical.unresolvedGroups.contains(key)
+                        && !modeEvidence.mismatchGroups.contains(key)
+                        && (rowPriced.contains(key) || unpriced.contains(key))
+                    if canSplit {
+                        let byMode = Dictionary(grouping: events) { row in
+                            row.pricingMode == "priority" || row.turnID.flatMap { priorityTurns[$0] } != nil
+                                ? "fast" : "standard"
+                        }
+                        for mode in byMode.keys.sorted() {
+                            let values = byMode[mode] ?? []
+                            let costs = values.map {
+                                CostUsageScanner.codexResolvedCostUSD(
+                                    for: $0,
+                                    priorityTurns: priorityTurns,
+                                    modelsDevCatalog: catalog,
+                                    modelsDevCacheRoot: cacheRoot)
+                            }
+                            let input = values.reduce(0) { $0 + $1.input }
+                            let output = values.reduce(0) { $0 + $1.output }
+                            rows.append(Row(
+                                date: day,
+                                model: model,
+                                mode: mode,
+                                inputTokens: input,
+                                cachedTokens: values.reduce(0) { $0 + $1.cached },
+                                outputTokens: output,
+                                totalTokens: input + output,
+                                estimatedCostUSD: !unpriced.contains(key) && costs.allSatisfy { $0 != nil }
+                                    ? costs.compactMap(\.self).reduce(0, +) : nil,
+                                eventCount: values.count))
+                        }
+                    } else {
+                        // Canonical totals remain valid even when inherited prefixes cannot
+                        // be assigned to individual pricing rows. Keep the price/mode gap.
+                        let input = packed.first ?? 0
+                        let cached = packed.count > 1 ? packed[1] : 0
+                        let output = packed.count > 2 ? packed[2] : 0
+                        rows.append(Row(
+                            date: day,
+                            model: model,
+                            mode: "unknown",
+                            inputTokens: input,
+                            cachedTokens: cached,
+                            outputTokens: output,
+                            totalTokens: input + output,
+                            estimatedCostUSD: unpriced.contains(key) ? nil : CostUsagePricing.codexAggregateCostUSD(
+                                model: model,
+                                inputTokens: input,
+                                cachedInputTokens: cached,
+                                outputTokens: output,
+                                modelsDevCatalog: catalog,
+                                modelsDevCacheRoot: cacheRoot),
+                            eventCount: max(1, events.count)))
+                    }
+                }
+            }
+            sources.append(Source(
+                id: "codex-file:" + (usage.sessionId ?? "") + ":" + (usage.codexScanFileId ?? path),
+                path: path,
+                sessionID: usage.sessionId ?? usage.codexSession?.sessionId,
+                project: usage.projectPath ?? usage.codexSession?.cwd,
+                title: usage.codexSession?.title,
+                complete: usage.codexScanComplete != false,
+                rows: rows))
+        }
+        if let piSource = Self.piSource(cache: pi, range: range, now: now, cacheRoot: cacheRoot) {
+            sources.append(piSource)
+        }
+        return Snapshot(
+            timeZone: range.calendar.timeZone.identifier,
+            startDay: range.sinceKey,
+            endDay: range.untilKey,
+            scannedAt: cache.lastScanUnixMs > 0
+                ? ISO8601DateFormatter()
+                .string(from: Date(timeIntervalSince1970: Double(cache.lastScanUnixMs) / 1000)) : nil,
+            complete: cache.codexScanCatchUpPending == false,
+            completedFiles: cache.codexScanCompletedFiles ?? 0,
+            totalFiles: cache.codexScanTotalFiles ?? 0,
+            processedBytes: cache.codexScanProcessedBytes ?? 0,
+            totalBytes: cache.codexScanTotalBytes ?? 0,
+            sources: sources)
+    }
+
+    private static func piSource(
+        cache: PiSessionCostCache,
+        range: CostUsageScanner.CostUsageDayRange,
+        now: Date,
+        cacheRoot: URL?) -> Source?
+    {
+        guard cache.timeZoneIdentifier == range.calendar.timeZone.identifier else { return nil }
+        let report = PiSessionCostScanner.plannerReport(cache: cache, range: range, now: now, cacheRoot: cacheRoot)
+        var rows: [Row] = []
+        for day in report.data {
+            for model in day.modelBreakdowns ?? [] {
+                let usage = cache.daysByProvider[UsageProvider.codex.rawValue]?[day.date]?[model.modelName]
+                    ?? PiPackedUsage()
+                rows.append(Row(
+                    date: day.date,
+                    model: model.modelName,
+                    mode: "unknown",
+                    inputTokens: usage.inputTokens + usage.cacheReadTokens + usage.cacheWriteTokens,
+                    cachedTokens: usage.cacheReadTokens,
+                    outputTokens: usage.outputTokens,
+                    totalTokens: model.totalTokens ?? 0,
+                    estimatedCostUSD: model.costUSD,
+                    eventCount: max(1, usage.usageSampleCount ?? 1)))
+            }
+        }
+        guard !rows.isEmpty else { return nil }
+        return Source(
+            id: "pi-omp:codex",
+            path: nil,
+            sessionID: nil,
+            project: nil,
+            title: "Pi / OMP",
+            complete: true,
+            rows: rows)
+    }
+
+    /// Match the native report's global trust gate before distributing its
+    /// prices by source. A per-file price can be valid while the global group
+    /// has insufficient evidence and intentionally uses aggregate pricing.
+    private static func rowPricedGroups(
+        cache: CostUsageCache,
+        range: CostUsageScanner.CostUsageDayRange,
+        catalog: ModelsDevCatalog?,
+        cacheRoot: URL?,
+        priorityTurns: [String: CostUsageScanner.CodexPriorityTurnMetadata])
+        -> Set<CostUsageScanner.CodexDayModelKey>
+    {
+        var grouped: [CostUsageScanner.CodexDayModelKey: [CostUsageScanner.CodexUsageRow]] = [:]
+        var unresolved = Set<CostUsageScanner.CodexDayModelKey>()
+        var mismatches = Set<CostUsageScanner.CodexDayModelKey>()
+        for usage in cache.files.values {
+            let canonical = CostUsageScanner.codexCanonicalPricingRows(usage)
+            unresolved.formUnion(canonical.unresolvedGroups)
+            mismatches.formUnion(CostUsageScanner.codexPricingModeEvidence(
+                usage: usage,
+                reconciledRows: canonical.rows,
+                range: range,
+                priorityTurns: priorityTurns)
+                .mismatchGroups)
+            for row in canonical.rows {
+                grouped[.init(day: row.day, model: row.model), default: []].append(row)
+            }
+        }
+        return Set(grouped.compactMap { key, rows in
+            let packed = cache.days[key.day]?[key.model] ?? [0, 0, 0]
+            let total = (packed.first ?? 0) + (packed.count > 2 ? packed[2] : 0)
+            let cost = CostUsageScanner.codexRowCostBreakdown(
+                rows: rows,
+                priorityTurns: priorityTurns,
+                modelsDevCatalog: catalog,
+                modelsDevCacheRoot: cacheRoot)
+            return !unresolved.contains(key) && !mismatches.contains(key) && cost.isTrusted(canonicalTotalTokens: total)
+                ? key : nil
+        })
+    }
+}
