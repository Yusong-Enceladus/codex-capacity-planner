@@ -0,0 +1,19 @@
+import Commander
+import Testing
+@testable import CodexBarCLI
+
+struct PlannerHistoryCommandTests {
+    @Test func `planner export options do not change ordinary cost defaults`() throws {
+        let parser = CommandParser(signature: CodexBarCLI._costSignatureForTesting())
+        let defaults = try parser.parse(arguments: [])
+        #expect(defaults.options["historyOutput"] == nil)
+        #expect(!defaults.flags.contains("historyCacheOnly"))
+        let custom = try parser.parse(arguments: [
+            "--history-output", "/tmp/synthetic-history.json", "--history-time-zone", "Asia/Shanghai",
+            "--history-cache-only", "--cache-root", "/tmp/synthetic-cache",
+        ])
+        #expect(custom.options["historyOutput"]?.last == "/tmp/synthetic-history.json")
+        #expect(custom.options["historyTimeZone"]?.last == "Asia/Shanghai")
+        #expect(custom.flags.contains("historyCacheOnly"))
+    }
+}
diff --git a/Tests/CodexBarTests/PlannerUsageExportTests.swift b/Tests/CodexBarTests/PlannerUsageExportTests.swift
new file mode 100644
index 0000000..5b00088
--- /dev/null
+++ b/Tests/CodexBarTests/PlannerUsageExportTests.swift
@@ -0,0 +1,234 @@
+import Foundation
+import Testing
+@testable import CodexBarCore
+
+struct PlannerUsageExportTests {
+    private let model = "gpt-5.6-sol"
+    private let day = "2026-08-29"
+
+    private func range() throws -> CostUsageScanner.CostUsageDayRange {
+        let date = try #require(ISO8601DateFormatter().date(from: "2026-08-29T12:00:00Z"))
+        var calendar = Calendar(identifier: .gregorian)
+        calendar.timeZone = try #require(TimeZone(identifier: "America/Los_Angeles"))
+        return CostUsageScanner.CostUsageDayRange(since: date, until: date, calendar: calendar)
+    }
+
+    private func row(
+        _ index: Int,
+        input: Int = 100,
+        cached: Int = 40,
+        mode: String = "standard",
+        cost: Int64? = nil) -> CostUsageScanner.CodexUsageRow
+    {
+        CostUsageScanner.CodexUsageRow(
+            day: self.day,
+            model: self.model,
+            turnID: "turn-\(index)",
+            eventIndex: index,
+            input: input,
+            cached: cached,
+            output: 10,
+            knownCostNanos: cost,
+            pricingMode: mode)
+    }
+
+    private func usage(
+        _ id: String,
+        rows: [CostUsageScanner.CodexUsageRow],
+        input: Int = 100,
+        cached: Int = 40,
+        output: Int = 10) -> CostUsageFileUsage
+    {
+        CostUsageScanner.makeFileUsage(
+            mtimeUnixMs: 1,
+            size: 1,
+            days: [self.day: [self.model: [input, cached, output]]],
+            parsedBytes: 1,
+            sessionId: id,
+            codexRows: rows,
+            codexScanComplete: true)
+    }
+
+    private func cache(_ usages: [CostUsageFileUsage]) -> CostUsageCache {
+        var cache = CostUsageCache()
+        cache.codexScanCatchUpPending = false
+        cache.codexScanCompletedFiles = usages.count
+        cache.codexScanTotalFiles = usages.count
+        for (index, usage) in usages.enumerated() {
+            cache.files["/synthetic-\(index).jsonl"] = usage
+            let totals = usage.days[self.day]?[self.model] ?? [0, 0, 0]
+            let previous = cache.days[self.day]?[self.model] ?? [0, 0, 0]
+            cache.days[self.day, default: [:]][self.model] = zip(previous, totals).map { $0.0 + $0.1 }
+        }
+        return cache
+    }
+
+    private func checkNativeEquality(_ cache: CostUsageCache, root: URL, catalog: ModelsDevCatalog? = nil) throws
+        -> PlannerUsageExport.Snapshot
+    {
+        let range = try self.range()
+        let native = CostUsageScanner.buildCodexReportFromCache(
+            cache: cache,
+            range: range,
+            modelsDevCatalog: catalog,
+            modelsDevCacheRoot: root)
+        let export = PlannerUsageExport.snapshot(cache: cache, range: range, catalog: catalog, cacheRoot: root)
+        let rows = export.sources.flatMap(\.rows)
+        #expect(rows.reduce(0) { $0 + $1.totalTokens } == native.summary?.totalTokens)
+        let prices = rows.compactMap(\.estimatedCostUSD)
+        if let expected = native.summary?.totalCostUSD {
+            #expect(abs(prices.reduce(0, +) - expected) < 1e-10)
+        } else {
+            #expect(prices.isEmpty)
+        }
+        return export
+    }
+
+    @Test func `fork prefixes are removed and request level pricing matches CodexBar`() throws {
+        let env = try CostUsageTestEnvironment()
+        defer { env.cleanup() }
+        let parent = self.row(0, input: 200_000)
+        let child = self.row(1, input: 200_000, mode: "priority")
+        let cache = self.cache([
+            self.usage("parent", rows: [parent], input: 200_000),
+            self.usage("child", rows: [parent, child], input: 200_000),
+        ])
+        let export = try self.checkNativeEquality(cache, root: env.cacheRoot)
+        #expect(export.sources.flatMap(\.rows).reduce(0) { $0 + $1.totalTokens } == 400_020)
+        #expect(Set(export.sources.flatMap(\.rows).map(\.mode)) == ["standard", "fast"])
+    }
+
+    @Test func `unresolved global prices are not replaced by plausible per file subtotals`() throws {
+        let env = try CostUsageTestEnvironment()
+        defer { env.cleanup() }
+        let prefix = self.row(0, input: 300_000, mode: "priority", cost: 5_000_000_000)
+        let cache = self.cache([
+            self.usage("unresolved", rows: [prefix, self.row(1)], input: 200_000),
+            self.usage("known", rows: [self.row(2)]),
+        ])
+        let export = try self.checkNativeEquality(cache, root: env.cacheRoot)
+        #expect(export.sources.flatMap(\.rows).allSatisfy { $0.estimatedCostUSD == nil })
+        #expect(export.sources.flatMap(\.rows).reduce(0) { $0 + $1.totalTokens } == 200_120)
+    }
+
+    @Test func `two legitimate files with one session ID are not collapsed`() throws {
+        let env = try CostUsageTestEnvironment()
+        defer { env.cleanup() }
