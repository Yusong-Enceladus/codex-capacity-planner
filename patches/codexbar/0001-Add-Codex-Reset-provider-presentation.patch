+import Foundation
+
+/// A compact, provider-defined decision bar. The fill is the observed value,
+/// the red marker is the target, and the optional blue marker and interval are
+/// the projected value and calibrated range at the same deadline.
+public struct ProviderDecisionProgress: Codable, Equatable, Sendable {
+    public static let maximumStringLength = 120
+
+    public let title: String
+    public let alternateTitle: String?
+    public let currentPercent: Double
+    public let targetPercent: Double
+    public let projectedPercent: Double?
+    public let projectedLowerPercent: Double?
+    public let projectedUpperPercent: Double?
+    public let currentLabel: String
+    public let targetLabel: String
+    public let projectedLabel: String?
+
+    public init(
+        title: String,
+        alternateTitle: String? = nil,
+        currentPercent: Double,
+        targetPercent: Double,
+        projectedPercent: Double? = nil,
+        projectedLowerPercent: Double? = nil,
+        projectedUpperPercent: Double? = nil,
+        currentLabel: String,
+        targetLabel: String,
+        projectedLabel: String? = nil) throws
+    {
+        self.title = try Self.requiredString(title, path: "title")
+        self.alternateTitle = try Self.optionalString(alternateTitle, path: "alternateTitle")
+        self.currentPercent = try Self.percent(currentPercent, path: "currentPercent")
+        self.targetPercent = try Self.percent(targetPercent, path: "targetPercent")
+        let projected = try projectedPercent.map { try Self.percent($0, path: "projectedPercent") }
+        let projectedLower = try projectedLowerPercent.map {
+            try Self.percent($0, path: "projectedLowerPercent")
+        }
+        let projectedUpper = try projectedUpperPercent.map {
+            try Self.percent($0, path: "projectedUpperPercent")
+        }
+        guard (projectedLower == nil) == (projectedUpper == nil) else {
+            throw ValidationError(
+                "projectedLowerPercent and projectedUpperPercent must be provided together")
+        }
+        if let projectedLower, let projectedUpper {
+            guard projectedLower <= projectedUpper else {
+                throw ValidationError("projectedLowerPercent must not exceed projectedUpperPercent")
+            }
+            if let projected, !(projectedLower...projectedUpper).contains(projected) {
+                throw ValidationError("projectedPercent must fall inside the projected range")
+            }
+        }
+        self.projectedPercent = projected
+        self.projectedLowerPercent = projectedLower
+        self.projectedUpperPercent = projectedUpper
+        self.currentLabel = try Self.requiredString(currentLabel, path: "currentLabel")
+        self.targetLabel = try Self.requiredString(targetLabel, path: "targetLabel")
+        self.projectedLabel = try Self.optionalString(projectedLabel, path: "projectedLabel")
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case title
+        case alternateTitle
+        case currentPercent
+        case targetPercent
+        case projectedPercent
+        case projectedLowerPercent
+        case projectedUpperPercent
+        case currentLabel
+        case targetLabel
+        case projectedLabel
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        try self.init(
+            title: container.decode(String.self, forKey: .title),
+            alternateTitle: container.decodeIfPresent(String.self, forKey: .alternateTitle),
+            currentPercent: container.decode(Double.self, forKey: .currentPercent),
+            targetPercent: container.decode(Double.self, forKey: .targetPercent),
+            projectedPercent: container.decodeIfPresent(Double.self, forKey: .projectedPercent),
+            projectedLowerPercent: container.decodeIfPresent(
+                Double.self,
+                forKey: .projectedLowerPercent),
+            projectedUpperPercent: container.decodeIfPresent(
+                Double.self,
+                forKey: .projectedUpperPercent),
+            currentLabel: container.decode(String.self, forKey: .currentLabel),
+            targetLabel: container.decode(String.self, forKey: .targetLabel),
+            projectedLabel: container.decodeIfPresent(String.self, forKey: .projectedLabel))
+    }
+
+    public struct ValidationError: LocalizedError, Equatable, Sendable {
+        public let message: String
+        public var errorDescription: String? {
+            self.message
+        }
+
+        init(_ message: String) {
+            self.message = message
+        }
+    }
+
+    private static func percent(_ value: Double, path: String) throws -> Double {
+        guard value.isFinite, (0...100).contains(value) else {
+            throw ValidationError("\(path) must be between 0 and 100")
+        }
+        return value
+    }
+
+    private static func requiredString(_ value: String, path: String) throws -> String {
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !trimmed.isEmpty else { throw ValidationError("\(path) must not be empty") }
+        guard trimmed.count <= Self.maximumStringLength else {
+            throw ValidationError("\(path) exceeds \(Self.maximumStringLength) characters")
+        }
+        return trimmed
+    }
+
+    private static func optionalString(_ value: String?, path: String) throws -> String? {
+        guard let value else { return nil }
+        let trimmed = value.trimmingCharacters(in: .whitespacesAndNewlines)
+        if trimmed.isEmpty { return nil }
+        guard trimmed.count <= Self.maximumStringLength else {
+            throw ValidationError("\(path) exceeds \(Self.maximumStringLength) characters")
+        }
+        return trimmed
+    }
+}
