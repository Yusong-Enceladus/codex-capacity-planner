--- /dev/null
+++ b/Tests/CodexBarTests/ProviderSubmenuDetailSectionTests.swift
@@ -0,0 +1,70 @@
+import Foundation
+import Testing
+@testable import CodexBarCore
+
+struct ProviderSubmenuDetailSectionTests {
+    @Test
+    func `construction preserves long wrapped text and safe links`() throws {
+        let source = String(repeating: "A full source paragraph. ", count: 12)
+        let link = try ProviderSubmenuDetailSection.Link(
+            label: " Open source ",
+            url: #require(URL(string: "https://example.com/post/42")))
+        let row = try ProviderSubmenuDetailSection.Row(
+            label: " Source text ",
+            value: " \(source) ",
+            secondaryValue: " Published today ",
+            link: link,
+            alternateValue: " 2 days from now ",
+            relativeTimeAt: " 2026-08-28T02:48:00Z ",
+            relativeTimePrefix: " Resets in ")
+        let section = try ProviderSubmenuDetailSection(title: " Details ", rows: [row])
+
+        #expect(section.title == "Details")
+        #expect(section.rows.first?.label == "Source text")
+        #expect(section.rows.first?.value == source.trimmingCharacters(in: .whitespacesAndNewlines))
+        #expect(section.rows.first?.secondaryValue == "Published today")
+        #expect(section.rows.first?.alternateValue == "2 days from now")
+        #expect(section.rows.first?.relativeTimeAt == "2026-08-28T02:48:00Z")
+        #expect(section.rows.first?.relativeTimePrefix == "Resets in")
+        #expect(section.rows.first?.link?.label == "Open source")
+        #expect(section.rows.first?.link?.url.absoluteString == "https://example.com/post/42")
+    }
+
+    @Test(arguments: [
+        "http://example.com/post",
+        "https://user:password@example.com/post",
+        "javascript:alert(1)",
+    ])
+    func `links reject unsafe destinations`(rawURL: String) throws {
+        let url = try #require(URL(string: rawURL))
+
+        #expect(throws: ProviderSubmenuDetailSection.ValidationError.self) {
+            _ = try ProviderSubmenuDetailSection.Link(label: "Open", url: url)
+        }
+    }
+
+    @Test
+    func `snapshot round trip preserves submenu details`() throws {
+        let link = try ProviderSubmenuDetailSection.Link(
+            label: "Open source",
+            url: #require(URL(string: "https://example.com/post")))
+        let section = try ProviderSubmenuDetailSection(
+            title: "Signal",
+            rows: [ProviderSubmenuDetailSection.Row(
+                label: "Full text",
+                value: "Untruncated source text",
+                link: link)])
+        let snapshot = try UsageSnapshot(
+            primary: nil,
+            secondary: nil,
+            details: [ProviderDetailSection(rows: [ProviderDetailSection.Row(
+                label: "Signal",
+                value: "Available")])],
+            submenuDetails: [section],
+            updatedAt: Date(timeIntervalSince1970: 1_700_000_000))
+        let data = try JSONEncoder().encode(snapshot)
+        let decoded = try JSONDecoder().decode(UsageSnapshot.self, from: data)
+
+        #expect(decoded.submenuDetails == [section])
+    }
+}
