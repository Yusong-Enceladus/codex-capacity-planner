+    private func makeUserPluginDetailsSubmenu(
+        plugin: UserProviderPlugin,
+        sections: [ProviderSubmenuDetailSection],
+        parentWidth: CGFloat) -> NSMenu?
+    {
+        guard !sections.isEmpty else { return nil }
+        let width = min(420, max(360, parentWidth))
+        if plugin.manifest.id.rawValue == "codex-reset-forecast" {
+            return self.makeCodexResetDetailsNavigation(sections: sections, width: width)
+        }
+        let submenu = NSMenu()
+        submenu.autoenablesItems = false
+        submenu.minimumWidth = width
+
+        if self.menuCardRenderingEnabledForController {
+            let detailsView = ProviderSubmenuDetailsContent(sections: sections, width: width)
+            let hosting = MenuHostingView(rootView: detailsView)
+            hosting.frame = NSRect(
+                origin: .zero,
+                size: NSSize(width: width, height: self.hostedSubviewFittingHeight(for: hosting, width: width)))
+            let detailsItem = NSMenuItem()
+            detailsItem.view = hosting
+            detailsItem.isEnabled = false
+            detailsItem.representedObject = "pluginSubmenuDetails:\(plugin.manifest.id.rawValue)"
+            submenu.addItem(detailsItem)
+        }
+
+        var seenURLs = Set<String>()
+        let links = sections.flatMap(\.rows).compactMap(\.link).filter { link in
+            seenURLs.insert(link.url.absoluteString).inserted
+        }
+        if !links.isEmpty, !submenu.items.isEmpty {
+            submenu.addItem(.separator())
+        }
+        for link in links {
+            let item = NSMenuItem(
+                title: link.label,
+                action: #selector(self.openUserPluginSubmenuLink(_:)),
+                keyEquivalent: "")
+            item.target = self
+            item.representedObject = link.url.absoluteString
+            item.toolTip = link.url.absoluteString
+            if let image = NSImage(systemSymbolName: "arrow.up.right.square", accessibilityDescription: nil) {
+                image.isTemplate = true
+                image.size = NSSize(width: 16, height: 16)
+                item.image = image
+            }
+            submenu.addItem(item)
+        }
+        return submenu.items.isEmpty ? nil : submenu
+    }
+
+    private func makeCodexResetDetailsNavigation(
+        sections: [ProviderSubmenuDetailSection],
+        width: CGFloat) -> NSMenu
+    {
+        let menu = NSMenu()
+        menu.autoenablesItems = false
+        menu.minimumWidth = width
+        for section in sections {
+            let title = section.title ?? "详情"
+            let item = NSMenuItem(title: title, action: nil, keyEquivalent: "")
+            item.image = NSImage(
+                systemSymbolName: Self.codexResetDetailsSymbol(for: title),
+                accessibilityDescription: nil)
+            item.submenu = self.makeCodexResetDetailSectionMenu(section, width: width)
+            item.isEnabled = true
+            menu.addItem(item)
+        }
+        return menu
+    }
+
+    private func makeCodexResetDetailSectionMenu(
+        _ section: ProviderSubmenuDetailSection,
+        width: CGFloat) -> NSMenu
+    {
+        let menu = NSMenu()
+        menu.autoenablesItems = false
+        menu.minimumWidth = width
+        let title = section.title ?? "详情"
+        let grouped = Dictionary(grouping: section.rows) { $0.group ?? "all" }
+        let summaryKey = title == "为什么这样建议" ? "summary" : "current"
+        let summaryRows = grouped[summaryKey] ?? (grouped.count == 1 ? section.rows : [])
+        if !summaryRows.isEmpty,
+           let summary = try? ProviderSubmenuDetailSection(title: title, rows: summaryRows)
+        {
+            self.addCodexResetDetailContent(summary, to: menu, width: width)
+        }
+
+        let groupOrder = title == "为什么这样建议"
+            ? ["calculation", "work", "data"]
+            : ["assets", "history", "official"]
+        for key in groupOrder {
+            guard let rows = grouped[key], !rows.isEmpty,
+                  let groupedSection = try? ProviderSubmenuDetailSection(
+                      title: Self.codexResetDetailGroupTitle(key),
+                      rows: rows)
+            else { continue }
+            if !menu.items.isEmpty, menu.items.last?.isSeparatorItem != true {
+                menu.addItem(.separator())
+            }
+            let item = NSMenuItem(
+                title: Self.codexResetDetailGroupTitle(key),
+                action: nil,
+                keyEquivalent: "")
+            item.image = NSImage(
+                systemSymbolName: Self.codexResetDetailGroupSymbol(key),
+                accessibilityDescription: nil)
+            item.submenu = self.makeCodexResetDetailLeafMenu(groupedSection, width: width)
+            item.isEnabled = true
+            menu.addItem(item)
+        }
+        if menu.items.isEmpty {
+            self.addCodexResetDetailContent(section, to: menu, width: width)
+        }
+        self.addCodexResetLinks(
+            grouped.count == 1 ? section.rows : summaryRows,
+            to: menu)
+        return menu
+    }
+
+    private func makeCodexResetDetailLeafMenu(
+        _ section: ProviderSubmenuDetailSection,
+        width: CGFloat) -> NSMenu
+    {
+        let menu = NSMenu()
+        menu.autoenablesItems = false
+        menu.minimumWidth = width
+        self.addCodexResetDetailContent(section, to: menu, width: width)
+        self.addCodexResetLinks(section.rows, to: menu)
+        return menu
+    }
+
+    private func addCodexResetDetailContent(
+        _ section: ProviderSubmenuDetailSection,
+        to menu: NSMenu,
+        width: CGFloat)
+    {
+        guard self.menuCardRenderingEnabledForController else { return }
+        let detailsView = ProviderSubmenuDetailsContent(sections: [section], width: width)
+        let hosting = MenuHostingView(rootView: detailsView)
+        hosting.frame = NSRect(
+            origin: .zero,
+            size: NSSize(width: width, height: self.hostedSubviewFittingHeight(for: hosting, width: width)))
+        let detailsItem = NSMenuItem()
+        detailsItem.view = hosting
+        detailsItem.isEnabled = false
+        menu.addItem(detailsItem)
+    }
+
+    private func addCodexResetLinks(
+        _ rows: [ProviderSubmenuDetailSection.Row],
+        to menu: NSMenu)
+    {
+        var seenURLs = Set<String>()
+        let links = rows.compactMap(\.link).filter { link in
+            seenURLs.insert(link.url.absoluteString).inserted
+        }
+        if !links.isEmpty, !menu.items.isEmpty { menu.addItem(.separator()) }
+        for link in links {
+            let item = NSMenuItem(
+                title: link.label,
+                action: #selector(self.openUserPluginSubmenuLink(_:)),
+                keyEquivalent: "")
+            item.target = self
+            item.representedObject = link.url.absoluteString
+            item.toolTip = link.url.absoluteString
+            item.image = NSImage(
+                systemSymbolName: "arrow.up.right.square",
+                accessibilityDescription: nil)
+            menu.addItem(item)
+        }
+    }
+
+    private static func codexResetDetailGroupTitle(_ key: String) -> String {
+        switch key {
+        case "calculation": "使用与目标"
+        case "work": "建议任务"
+        case "data": "计算与数据"
+        case "assets": "可用重置"
+        case "history": "重置历史"
+        case "official": "官方消息"
+        default: "更多信息"
+        }
+    }
+
+    private static func codexResetDetailGroupSymbol(_ key: String) -> String {
+        switch key {
+        case "calculation": "scope"
+        case "work": "play.circle"
+        case "data": "waveform.path.ecg"
+        case "assets": "ticket"
+        case "history": "clock.arrow.circlepath"
+        case "official": "megaphone"
+        default: "ellipsis.circle"
+        }
+    }
+
+    private static func codexResetDetailsSymbol(for title: String) -> String {
+        switch title {
+        case "可继续的任务": "play.circle"
+        case "账户": "person.2"
+        case "为什么这样建议": "chart.line.uptrend.xyaxis"
+        case "重置": "clock.arrow.circlepath"
+        default: "list.bullet.rectangle"
+        }
+    }
+
+    @objc private func openUserPluginSubmenuLink(_ sender: NSMenuItem) {
+        guard let rawURL = sender.representedObject as? String,
+              let url = URL(string: rawURL),
+              url.scheme?.lowercased() == "https",
+              url.host?.isEmpty == false,
+              url.user == nil,
+              url.password == nil
+        else { return }
+        NSWorkspace.shared.open(url)
+    }
 }
 
