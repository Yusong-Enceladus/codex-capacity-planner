diff --git a/Sources/CodexBarCore/ProviderSubmenuDetailSection.swift b/Sources/CodexBarCore/ProviderSubmenuDetailSection.swift
new file mode 100644
index 0000000..915ed96
--- /dev/null
+++ b/Sources/CodexBarCore/ProviderSubmenuDetailSection.swift
@@ -0,0 +1,201 @@
+import Foundation
+
+/// Supplemental provider details rendered in a native side submenu.
+///
+/// Unlike `ProviderDetailSection`, submenu values may contain paragraph-length
+/// source text. The payload remains bounded so a plugin cannot create an
+/// unreasonably large menu or cached snapshot.
+public struct ProviderSubmenuDetailSection: Codable, Equatable, Sendable {
+    public static let maximumSectionsPerSnapshot = 8
+    public static let maximumRowsPerSection = 32
+    public static let maximumLabelLength = 120
+    public static let maximumValueLength = 2000
+    public static let maximumSecondaryValueLength = 500
+    public static let maximumLinkLabelLength = 120
+    public static let maximumLinkURLLength = 2048
+
+    public struct Link: Codable, Equatable, Sendable {
+        public let label: String
+        public let url: URL
+
+        public init(label: String, url: URL) throws {
+            self.label = try ProviderSubmenuDetailSection.requiredString(
+                label,
+                maximumLength: ProviderSubmenuDetailSection.maximumLinkLabelLength,
+                path: "link.label")
+            let absoluteString = url.absoluteString
+            guard absoluteString.count <= ProviderSubmenuDetailSection.maximumLinkURLLength else {
+                throw ValidationError(
+                    "link.url exceeds \(ProviderSubmenuDetailSection.maximumLinkURLLength) characters")
+            }
+            guard url.scheme?.lowercased() == "https",
+                  url.host?.isEmpty == false,
+                  url.user == nil,
+                  url.password == nil
+            else {
+                throw ValidationError("link.url must be an HTTPS URL without credentials")
+            }
+            self.url = url
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case label
+            case url
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            try self.init(
+                label: container.decode(String.self, forKey: .label),
+                url: container.decode(URL.self, forKey: .url))
+        }
+    }
+
+    public struct Row: Codable, Equatable, Sendable {
+        public let label: String
+        public let value: String
+        public let secondaryValue: String?
+        public let link: Link?
+        public let group: String?
+        public let alternateValue: String?
+        public let relativeTimeAt: String?
+        public let relativeTimePrefix: String?
+
+        public init(
+            label: String,
+            value: String,
+            secondaryValue: String? = nil,
+            link: Link? = nil,
+            group: String? = nil,
+            alternateValue: String? = nil,
+            relativeTimeAt: String? = nil,
+            relativeTimePrefix: String? = nil) throws
+        {
+            self.label = try ProviderSubmenuDetailSection.requiredString(
+                label,
+                maximumLength: ProviderSubmenuDetailSection.maximumLabelLength,
+                path: "row.label")
+            self.value = try ProviderSubmenuDetailSection.requiredString(
+                value,
+                maximumLength: ProviderSubmenuDetailSection.maximumValueLength,
+                path: "row.value")
+            self.secondaryValue = try ProviderSubmenuDetailSection.optionalString(
+                secondaryValue,
+                maximumLength: ProviderSubmenuDetailSection.maximumSecondaryValueLength,
+                path: "row.secondaryValue")
+            self.link = link
+            self.group = try ProviderSubmenuDetailSection.optionalString(
+                group,
+                maximumLength: ProviderSubmenuDetailSection.maximumLabelLength,
+                path: "row.group")
+            self.alternateValue = try ProviderSubmenuDetailSection.optionalString(
+                alternateValue,
+                maximumLength: ProviderSubmenuDetailSection.maximumValueLength,
+                path: "row.alternateValue")
+            self.relativeTimeAt = try ProviderSubmenuDetailSection.optionalString(
+                relativeTimeAt,
+                maximumLength: ProviderSubmenuDetailSection.maximumLabelLength,
+                path: "row.relativeTimeAt")
+            self.relativeTimePrefix = try ProviderSubmenuDetailSection.optionalString(
+                relativeTimePrefix,
+                maximumLength: ProviderSubmenuDetailSection.maximumLabelLength,
+                path: "row.relativeTimePrefix")
+        }
+
+        private enum CodingKeys: String, CodingKey {
+            case label
+            case value
+            case secondaryValue
+            case link
+            case group
+            case alternateValue
+            case relativeTimeAt
+            case relativeTimePrefix
+        }
+
+        public init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            try self.init(
+                label: container.decode(String.self, forKey: .label),
+                value: container.decode(String.self, forKey: .value),
+                secondaryValue: container.decodeIfPresent(String.self, forKey: .secondaryValue),
+                link: container.decodeIfPresent(Link.self, forKey: .link),
+                group: container.decodeIfPresent(String.self, forKey: .group),
+                alternateValue: container.decodeIfPresent(String.self, forKey: .alternateValue),
+                relativeTimeAt: container.decodeIfPresent(String.self, forKey: .relativeTimeAt),
+                relativeTimePrefix: container.decodeIfPresent(String.self, forKey: .relativeTimePrefix))
+        }
+    }
+
+    public struct ValidationError: LocalizedError, Equatable, Sendable {
+        public let message: String
+
+        public init(_ message: String) {
+            self.message = message
+        }
+
+        public var errorDescription: String? {
+            self.message
+        }
+    }
+
+    public let title: String?
+    public let rows: [Row]
+
+    public init(title: String? = nil, rows: [Row]) throws {
+        guard rows.count <= Self.maximumRowsPerSection else {
+            throw ValidationError("section.rows exceeds \(Self.maximumRowsPerSection) entries")
+        }
+        self.title = try Self.optionalString(
+            title,
+            maximumLength: Self.maximumLabelLength,
+            path: "section.title")
+        self.rows = rows
+    }
+
+    public static func validateSections(_ sections: [Self]) throws {
+        guard sections.count <= self.maximumSectionsPerSnapshot else {
+            throw ValidationError("snapshot.submenuDetails exceeds \(self.maximumSectionsPerSnapshot) sections")
+        }
+    }
+
+    private enum CodingKeys: String, CodingKey {
+        case title
+        case rows
+    }
+
+    public init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        try self.init(
+            title: container.decodeIfPresent(String.self, forKey: .title),
+            rows: container.decode([Row].self, forKey: .rows))
+    }
+
+    private static func requiredString(
+        _ rawValue: String,
+        maximumLength: Int,
+        path: String) throws -> String
+    {
+        let value = rawValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !value.isEmpty else {
+            throw ValidationError("\(path) must not be empty")
+        }
+        guard value.count <= maximumLength else {
+            throw ValidationError("\(path) exceeds \(maximumLength) characters")
+        }
+        return value
+    }
+
+    private static func optionalString(
+        _ rawValue: String?,
+        maximumLength: Int,
+        path: String) throws -> String?
+    {
+        guard let rawValue else { return nil }
+        let value = rawValue.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard value.count <= maximumLength else {
+            throw ValidationError("\(path) exceeds \(maximumLength) characters")
+        }
+        return value.isEmpty ? nil : value
+    }
+}
