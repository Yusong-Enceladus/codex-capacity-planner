+private struct ProviderDecisionProgressBar: View {
+    static let targetColor = Color(red: 1, green: 0, blue: 0)
+    static let projectionColor = Color.cyan
+    static let markerWidth: CGFloat = 3
+    static let markerHeight: CGFloat = 10
+
+    let progress: ProviderDecisionProgress
+    let tint: Color
+
+    var body: some View {
+        ZStack {
+            UsageProgressBar(
+                percent: self.progress.currentPercent,
+                tint: self.tint,
+                accessibilityLabel: self.progress.title)
+                .accessibilityHidden(true)
+
+            GeometryReader { geometry in
+                let offsets = self.markerOffsets(width: geometry.size.width)
+                if let lower = self.progress.projectedLowerPercent,
+                   let upper = self.progress.projectedUpperPercent
+                {
+                    self.projectionRange(
+                        lowerPercent: lower,
+                        upperPercent: upper,
+                        width: geometry.size.width,
+                        height: geometry.size.height)
+                }
+                self.marker(
+                    percent: self.progress.targetPercent,
+                    xOffset: offsets.target,
+                    color: Self.targetColor,
+                    width: geometry.size.width,
+                    height: geometry.size.height)
+
+                if let projectedPercent = self.progress.projectedPercent {
+                    self.marker(
+                        percent: projectedPercent,
+                        xOffset: offsets.projection,
+                        color: Self.projectionColor,
+                        width: geometry.size.width,
+                        height: geometry.size.height)
+                }
+            }
+        }
+        .frame(height: 10)
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(self.progress.title)
+        .accessibilityValue(self.accessibilityValue)
+    }
+
+    private func projectionRange(
+        lowerPercent: Double,
+        upperPercent: Double,
+        width: CGFloat,
+        height: CGFloat) -> some View
+    {
+        let lowerX = width * min(100, max(0, lowerPercent)) / 100
+        let upperX = width * min(100, max(0, upperPercent)) / 100
+        let rangeWidth = max(3, upperX - lowerX)
+        return Capsule()
+            .fill(Self.projectionColor.opacity(0.22))
+            .overlay {
+                Capsule().stroke(Self.projectionColor.opacity(0.7), lineWidth: 0.75)
+            }
+            .frame(width: rangeWidth, height: 6)
+            .position(x: (lowerX + upperX) / 2, y: height / 2)
+            .accessibilityHidden(true)
+    }
+
+    private func marker(
+        percent: Double,
+        xOffset: CGFloat,
+        color: Color,
+        width: CGFloat,
+        height: CGFloat) -> some View
+    {
+        let clamped = min(100, max(0, percent))
+        let x = min(max(width * clamped / 100 + xOffset, 2.5), max(2.5, width - 2.5))
+        return Capsule()
+            .fill(color)
+            .frame(width: Self.markerWidth, height: Self.markerHeight)
+            .position(x: x, y: height / 2)
+            .accessibilityHidden(true)
+    }
+
+    private func markerOffsets(width: CGFloat) -> (target: CGFloat, projection: CGFloat) {
+        guard let projectedPercent = self.progress.projectedPercent else { return (0, 0) }
+        let targetX = width * min(100, max(0, self.progress.targetPercent)) / 100
+        let projectionX = width * min(100, max(0, projectedPercent)) / 100
+        return abs(targetX - projectionX) < 6 ? (-2, 2) : (0, 0)
+    }
+
+    private var accessibilityValue: String {
+        [
+            self.progress.currentLabel,
+            self.progress.targetLabel,
+            self.progress.projectedLabel,
+        ]
+            .compactMap(\.self)
+            .joined(separator: "；")
+    }
+
+    static func legend(color: Color, text: String) -> some View {
+        HStack(spacing: 4) {
