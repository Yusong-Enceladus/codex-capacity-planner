+import Foundation
+import Testing
+@testable import CodexBarCLI
+
+struct CLIAccountMetadataTests {
+    @Test
+    func `serve JSON exposes stable account selection metadata`() throws {
+        let payload = ProviderPayload(
+            provider: .codex,
+            account: "fixture@example.test",
+            cacheAccountKey: "codex:stored:fixture",
+            accountActive: true,
+            accountLive: false,
+            version: nil,
+            source: "fixture",
+            status: nil,
+            usage: nil,
+            credits: nil,
+            antigravityPlanInfo: nil,
+            openaiDashboard: nil,
+            error: nil)
+        let data = try JSONEncoder().encode(payload)
+        let json = try #require(JSONSerialization.jsonObject(with: data) as? [String: Any])
+        #expect(json["cacheAccountKey"] as? String == "codex:stored:fixture")
+        #expect(json["accountActive"] as? Bool == true)
+        #expect(json["accountLive"] as? Bool == false)
+    }
+}
